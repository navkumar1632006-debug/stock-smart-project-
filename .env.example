# StockSmart AI — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets to version control.

# Supabase — Required for authentication and database
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# App Configuration
APP_URL=http://localhost:3000
PORT=3000

# AI Provider Credentials (Server-side / Edge Functions)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
HF_TOKEN=YOUR_HUGGINGFACE_TOKEN_HERE

# Google OAuth Credentials (Optional)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
