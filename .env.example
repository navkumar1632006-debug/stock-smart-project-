# StockSmart AI — Environment Configuration
# Copy this file to .env and fill in your values.

# Supabase — Required for authentication and database
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# AI Operations — Handled server-side in Supabase Edge Functions (HF_TOKEN secret)

# App URL — The URL where this app is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=http://localhost:3000
