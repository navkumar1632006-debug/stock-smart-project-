{
  "name": "brainbattle-mobile-appium",
  "version": "1.0.0",
  "description": "Independent Appium Mobile E2E Testing Framework for StockSmart AI Android Application",
  "main": "config/wdio.conf.js",
  "type": "module",
  "scripts": {
    "test": "wdio run config/wdio.conf.js",
    "test:auth": "SPEC=tests/auth.test.js wdio run config/wdio.conf.js",
    "test:dashboard": "SPEC=tests/dashboard.test.js wdio run config/wdio.conf.js",
    "test:pos": "SPEC=tests/pos.test.js wdio run config/wdio.conf.js",
    "generate-matrix": "node utils/generateMobileCoverageMatrix.js"
  },
  "dependencies": {
    "@wdio/appium-service": "^9.2.8",
    "@wdio/cli": "^9.2.8",
    "@wdio/local-runner": "^9.2.8",
    "@wdio/mocha-framework": "^9.2.8",
    "@wdio/spec-reporter": "^9.2.8",
    "appium": "^2.16.2",
    "appium-uiautomator2-driver": "^3.9.11",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0"
  }
}
